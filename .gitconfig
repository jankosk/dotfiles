[user]
	name = <name-here>
	email = <email-here>

[color]
	diff = auto
	status = auto
	branch = auto
	ui = true

[pull]
	rebase = true

[rebase]
	autostash = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # use n and N to move between diff sections

[merge]
	conflictStyle = zdiff3

[alias]
    difft = !GIT_EXTERNAL_DIFF=difft git diff
